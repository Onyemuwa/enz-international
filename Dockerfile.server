# Backend — plain Node image. No native build step needed (uses node:sqlite,
# not better-sqlite3), so alpine works without a compiler toolchain.

FROM node:22-alpine
WORKDIR /app
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev
COPY server/src ./src
EXPOSE 4000
CMD ["node", "src/index.js"]
