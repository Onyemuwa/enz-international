# Copy to .env for local development. Railway takes these from the service's
# Variables tab instead — never commit a real .env (it is git-ignored).
#
# Local dev: `npm run dev` does not load .env by itself. Use
#   node --env-file=.env server/index.js
# or set the variables in your shell.

# ---- Required for the admin page ------------------------------------------
# The admin (/admin/) is switched OFF until this is set. Use a long random
# passphrase: it is the only thing protecting every enquiry.
ADMIN_PASSWORD=
ADMIN_USER=admin

# ---- Email alerts for new enquiries (Resend, https://resend.com) -----------
# Without RESEND_API_KEY enquiries are still saved and visible in the admin,
# but nobody is emailed.
RESEND_API_KEY=
# Who is emailed. Comma-separated. Defaults to info@enzinternational.co.
NOTIFY_TO=info@enzinternational.co
# Sender. Until a domain is verified in Resend, use the default below — it can
# only deliver to the email address that owns the Resend account. Once
# enzinternational.co is verified there, use e.g.:
#   ENZ Website <notifications@enzinternational.co>
NOTIFY_FROM=ENZ Website <onboarding@resend.dev>

# ---- Storage ---------------------------------------------------------------
# On Railway a Volume mounted at /data sets RAILWAY_VOLUME_MOUNT_PATH for you,
# and the database goes there automatically — leave these unset. Override only
# if you keep data somewhere else. Uploads (CVs) default to <data dir>/uploads.
# DATA_DIR=/data
# DATABASE_PATH=/data/enz.db
# UPLOAD_DIR=/data/uploads

# ---- Site ------------------------------------------------------------------
# Canonical address: used for the www -> apex redirect and links in emails.
SITE_URL=https://enzinternational.co
# Only if the static site is hosted somewhere else (e.g. Vercel) and calls this
# server cross-origin. Comma-separated exact origins. Empty = same-origin only.
ALLOWED_ORIGINS=

# PORT is set by Railway. NODE_ENV=production is implied on Railway.
