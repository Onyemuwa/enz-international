# Copy to .env and fill in to make forms actually send somewhere.
# Leave both of the below unset to run in mock mode (forms work locally, nothing is sent).

# Option A — the real backend in server/ (full persistence, real portal auth):
VITE_API_BASE_URL=

# Option B — no backend at all: forms POST straight to Web3Forms, which emails
# the submission to your inbox. Free key in ~30 seconds, no account/password:
# https://web3forms.com. If both this and VITE_API_BASE_URL are set, the real
# backend wins (Web3Forms can't do portal auth, only form-to-email).
VITE_WEB3FORMS_ACCESS_KEY=

# Analytics — loaded only after a visitor accepts cookies (see src/lib/analytics.js
# and the CookieConsent component). Leave blank to skip analytics entirely.
VITE_GA4_MEASUREMENT_ID=
VITE_GTM_CONTAINER_ID=

# Error monitoring — same consent gate, lazy-loaded (see src/lib/monitoring.js).
VITE_SENTRY_DSN=
