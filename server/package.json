{
  "name": "enz-international-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reference backend implementing the API contract documented in ../SETUP.md. SQLite-backed, no external services required to run locally.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
