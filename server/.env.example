# Copy to .env before running the server.

PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Required in production — a long random string (e.g. `openssl rand -hex 32`).
# The server refuses to start with the insecure dev default outside NODE_ENV=development.
JWT_SECRET=dev-only-insecure-secret-change-me

# SMTP — leave unset to log emails to the console instead of sending them (dev-safe default).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@enzinternational.com
MAIL_TO=info@enzinternational.com

# Used only by `npm run seed:admin` to create/update a client-portal login.
SEED_ADMIN_EMAIL=client@enzinternational.com
SEED_ADMIN_PASSWORD=change-me-immediately
SEED_ADMIN_NAME=Demo Client
